{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "files": {
    "includes": [
      "**",
      "!corpus/reports",
      "!corpus/.cache",
      "!corpus/checkout-audit-*.json",
      "!corpus/popularity-search-*.json",
      "!corpus/canonical-identity-inventory-2026-10-14.json",
      "!results",
      "!docs",
      "!.cache",
      "!package-lock.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
